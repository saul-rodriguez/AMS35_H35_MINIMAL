      genericDevice("PDL2N02S01")		
      genericDevice("PDL2N02S02")	
      genericDevice("PDL2N05S02")
;;      genericDevice("VXCAP")
   ) ;; end schematic


   mergeParallel(CAP merge parallelCAP)
   mergeParallel(DIODE merge parallelDIODE)

