   compareParameter("PDV1N01G002" percent("w" 1 "l" 1 "nf" 1 "filterID" 0))
   compareParameter("PDV1N02S001" percent("w" 1 "l" 1 "nf" 1))
   compareParameter("PDV1N02S002" percent("w" 1 "l" 1 "nf" 1))
   compareParameter("PDV1N02G001" percent("w" 1 "l" 1 "nf" 1 "filterID" 0))
   compareParameter("PDV1N02G002" percent("w" 1 "l" 1 "nf" 1 "filterID" 0))
   compareParameter("PHDPINB750" percent("w" 1 "l" 1 "nf" 1))
