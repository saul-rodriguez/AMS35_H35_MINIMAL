avCompareRules(
  ; Global Variables

  hgp=5e-9
  LVSdebug=0
   parameterModifiedDevice("NMOS4"  ("SUBTYPE" ""))   ; for WAFFLE
   parameterModifiedDevice("PMOS4"  ("SUBTYPE" ""))   ; for WAFFLE
