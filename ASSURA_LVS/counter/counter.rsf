   parameterModifiedDevice("PMOSIM"  ("SUBTYPE" ""))   ; for WAFFLE

   layout(
      lddDevice("NMOS18T"  ("D" "G" "S" "B") "W" "L" "M" )
      lddDevice("NMOS30M"  ("D" "G" "S" "B") "W" "L" "M" )
